# Copy to .env.local and fill in.

# Discount (percent) every pre-order customer gets. Default 10.
PREORDER_DISCOUNT_PERCENT=10

# Secret for the admin endpoints (list pre-orders, redeem codes). At least 16 characters.
# Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=

# Where the SQLite file lives. Default: ./data/preorders.db
# PREORDER_DB_PATH=/var/data/preorders.db
